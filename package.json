{
  "name": "halocline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Halocline \u2014 a generative art drop that grows on the block clock and blooms by the hand of its keeper.",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:traits": "tsx scripts/audit-traits.ts",
    "audit:pixels": "tsx scripts/audit-pixels.ts",
    "shoot": "node scripts/shoot.mjs",
    "provenance": "tsx scripts/provenance.ts",
    "render:canonical": "node scripts/render-canonical.mjs",
    "test:determinism": "node scripts/determinism.mjs",
    "dev:raw": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@noble/hashes": "^2.4.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
